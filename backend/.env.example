# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (SQL Server) ────────────────────────────────────────────────────
# Format: sqlserver://HOST:PORT;database=DB_NAME;user=USER;password=PASS;encrypt=true
DATABASE_URL="sqlserver://localhost:1433;database=stage_db;user=sa;password=YourPassword;encrypt=false"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── API Key (for external/internal API access) ────────────────────────────────
API_KEY=your_api_key_here

# ─── Frontend URL (for CORS and email links) ──────────────────────────────────
FRONTEND_URL=http://localhost:3000
